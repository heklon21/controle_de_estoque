@page "/operacional"

@inject StockInventory Inventory
@inject StockMovementService MovementService

<PageTitle>Dashboard Operacional | Controle de estoque</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">DASHBOARDS</p>
        <h1>Operacional</h1>
        <p class="subtitle">Acompanhe o saldo total em estoque e o CMV.</p>
    </div>
</section>

<section class="dashboard-grid" aria-label="Indicadores operacionais">
    <article id="dashboard-stock-total" class="dashboard-stat">
        <span class="dashboard-stat-label">Saldo total em estoque</span>
        <strong class="dashboard-stat-value">@FormatCurrency(Inventory.TotalValue)</strong>
        <span class="dashboard-stat-caption">Valor dos insumos cadastrados</span>
    </article>
    <article id="dashboard-cmv" class="dashboard-stat">
        <span class="dashboard-stat-label">CMV da semana passada</span>
        <strong class="dashboard-stat-value">
            @(PreviousWeekCmv.Percentage is decimal percentage
                ? $"{percentage.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"))}%"
                : "—")
        </strong>
        <span class="dashboard-stat-caption">
            @if (PreviousWeekCmv.Percentage is null)
            {
                <span>Aguardando compras e faturamento do PDV</span>
            }
            else
            {
                <span>@($"Semana de {PreviousWeekCmv.PeriodStart:dd/MM/yyyy} a {PreviousWeekCmv.PeriodEnd:dd/MM/yyyy}")</span>
            }
        </span>
    </article>
</section>

@code {
    private WeeklyCmv PreviousWeekCmv =>
        MovementService.CalculatePreviousWeekCmv(DateTime.Today, purchases: null, revenue: null);

    private static string FormatCurrency(decimal value) =>
        value.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));
}
