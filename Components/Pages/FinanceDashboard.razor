@page "/financeiro"

<PageTitle>Dashboard Financeiro | Controle de estoque</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">DASHBOARDS</p>
        <h1>Financeiro</h1>
        <p class="subtitle">Acompanhe as entradas e saídas financeiras.</p>
    </div>
</section>

<section class="dashboard-grid" aria-label="Indicadores financeiros">
    <article id="dashboard-cash-balance" class="dashboard-stat">
        <span class="dashboard-stat-label">Saldo de caixa</span>
        <strong class="dashboard-stat-value">—</strong>
        <div class="cash-balance-period-filter">
            <span class="cash-balance-period-label">Período</span>
            <div class="cash-balance-date-fields">
                <div class="cash-balance-date-field">
                    <label for="cash-balance-start-date">Data inicial</label>
                    <InputDate id="cash-balance-start-date" @bind-Value="_startDate" />
                </div>
                <div class="cash-balance-date-field">
                    <label for="cash-balance-end-date">Data final</label>
                    <InputDate id="cash-balance-end-date" @bind-Value="_endDate" />
                </div>
            </div>
            <div class="cash-balance-period-presets" role="group" aria-label="Filtrar saldo de caixa por período">
                <button class="cash-balance-period-preset @GetMonthPresetClass(previousMonth: false)"
                        type="button"
                        aria-pressed="@IsMonthPresetSelected(previousMonth: false)"
                        @onclick="() => ApplyMonthPreset(previousMonth: false)">
                    Mês atual
                </button>
                <button class="cash-balance-period-preset @GetMonthPresetClass(previousMonth: true)"
                        type="button"
                        aria-pressed="@IsMonthPresetSelected(previousMonth: true)"
                        @onclick="() => ApplyMonthPreset(previousMonth: true)">
                    Mês anterior
                </button>
            </div>
            <span class="cash-balance-period-caption">@SelectedPeriodCaption</span>
            @if (!HasValidDateRange)
            {
                <span class="cash-balance-date-error" role="alert">A data inicial deve ser anterior ou igual à data final.</span>
            }
        </div>
        <span class="dashboard-stat-caption">Aguardando lançamentos de caixa</span>
    </article>
</section>

<section class="panel inventory-panel" aria-labelledby="cash-flow-title">
    <div class="panel-heading">
        <div>
            <h2 id="cash-flow-title">Fluxo de caixa</h2>
            <p>Acompanhe as entradas e saídas financeiras.</p>
        </div>
    </div>
    <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">R$</div>
        <strong>Fluxo de caixa</strong>
        <p>Os lançamentos financeiros aparecerão aqui.</p>
    </div>
</section>

@code {
    private DateTime? _startDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _endDate = DateTime.Today;

    private bool HasValidDateRange =>
        _startDate is null || _endDate is null || _startDate.Value.Date <= _endDate.Value.Date;

    private string SelectedPeriodCaption
    {
        get
        {
            if (!HasValidDateRange)
            {
                return "Período inválido";
            }

            return $"Período: {_startDate?.ToString("dd/MM/yyyy") ?? "início"} a {_endDate?.ToString("dd/MM/yyyy") ?? "hoje"}";
        }
    }

    private bool IsMonthPresetSelected(bool previousMonth)
    {
        var today = DateTime.Today;
        var currentMonthStart = new DateTime(today.Year, today.Month, 1);
        var (start, end) = previousMonth
            ? (currentMonthStart.AddMonths(-1), currentMonthStart.AddDays(-1))
            : (currentMonthStart, today);

        return _startDate?.Date == start && _endDate?.Date == end;
    }

    private string GetMonthPresetClass(bool previousMonth) =>
        IsMonthPresetSelected(previousMonth) ? "selected" : string.Empty;

    private void ApplyMonthPreset(bool previousMonth)
    {
        var today = DateTime.Today;
        var currentMonthStart = new DateTime(today.Year, today.Month, 1);
        (_startDate, _endDate) = previousMonth
            ? (currentMonthStart.AddMonths(-1), currentMonthStart.AddDays(-1))
            : (currentMonthStart, today);
    }
}
