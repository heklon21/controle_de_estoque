@page "/insumos"
@page "/controle-de-estoque"

@inject StockInventory Inventory
@inject StockMovementService MovementService

<PageTitle>Cadastro de insumos | Controle de estoque</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">CONTROLE DE ESTOQUE</p>
        <h1>Cadastro de insumos</h1>
        <p class="subtitle">Cadastre seus insumos e acompanhe o valor total do estoque.</p>
    </div>
</section>

<div class="content-grid">
    <section class="panel form-panel">
        <div class="panel-heading">
            <div class="panel-icon" aria-hidden="true">+</div>
            <div>
                <h2>Adicionar insumo</h2>
                <p>Preencha os dados do item.</p>
            </div>
        </div>

        <EditForm Model="_form" OnValidSubmit="AddItem" class="stock-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="field">
                <label for="item-name">Nome do insumo</label>
                <InputText id="item-name" @bind-Value="_form.Name" placeholder="Ex.: Papel A4" />
                <ValidationMessage For="() => _form.Name" />
            </div>

            <div class="field">
                <label for="item-category">Categoria</label>
                <InputSelect id="item-category"
                             @bind-Value="_form.CategoryId"
                             disabled="@(Inventory.Categories.Count == 0)">
                    <option value="">Selecione uma categoria</option>
                    @foreach (var category in Inventory.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _form.CategoryId" />
                @if (Inventory.Categories.Count == 0)
                {
                    <a class="field-hint" href="/categorias">Cadastre uma categoria para continuar.</a>
                }
            </div>

            <div class="field">
                <label for="item-value">Valor unitário</label>
                <div class="input-with-prefix">
                    <span aria-hidden="true">R$</span>
                    <InputNumber id="item-value" @bind-Value="_form.Value" min="0" step="0.01" />
                </div>
                <ValidationMessage For="() => _form.Value" />
            </div>

            <button class="button button-primary"
                    type="submit"
                    disabled="@(Inventory.Categories.Count == 0)">
                Adicionar ao estoque
            </button>
        </EditForm>
    </section>

    <div class="inventory-column">
        <section class="panel stock-total-filters inventory-filters" aria-label="Filtros dos insumos cadastrados">
            <div class="stock-filter-fields">
                <div class="field">
                    <label for="items-start-date">Movimentações a partir de</label>
                    <InputDate id="items-start-date" @bind-Value="_startDate" />
                </div>
                <div class="field">
                    <label for="items-end-date">Movimentações até</label>
                    <InputDate id="items-end-date" @bind-Value="_endDate" />
                </div>
                <div class="field">
                    <label for="items-category">Categoria</label>
                    <InputSelect id="items-category" @bind-Value="_categoryId">
                        <option value="">Todas as categorias</option>
                        @foreach (var category in Inventory.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="field stock-search-field">
                    <label for="items-search">Buscar insumo</label>
                    <InputText id="items-search"
                               @bind-Value="_search"
                               @bind-Value:event="oninput"
                               placeholder="Digite o nome do insumo" />
                </div>
                <button class="button button-secondary clear-stock-filters"
                        type="button"
                        disabled="@(!HasFilters)"
                        @onclick="ClearFilters">
                    Limpar filtros
                </button>
            </div>
            @if (HasInvalidDateRange)
            {
                <p class="form-error stock-filter-error" role="alert">
                    A data inicial deve ser anterior ou igual à data final.
                </p>
            }
            <p class="stock-filter-hint">O período considera as datas das movimentações.</p>
        </section>

        <section class="panel inventory-panel">
            <div class="panel-heading inventory-heading">
                <div>
                    <h2>Itens cadastrados</h2>
                    <p>Exibindo @FilteredItems.Count de @Inventory.Items.Count insumos cadastrados.</p>
                </div>
            </div>

            @if (FilteredItems.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon" aria-hidden="true">□</div>
                    @if (Inventory.Items.Count == 0)
                    {
                        <strong>Nenhum insumo por aqui</strong>
                        <p>Adicione seu primeiro item usando o formulário.</p>
                    }
                    else if (HasInvalidDateRange)
                    {
                        <strong>Período inválido</strong>
                        <p>Corrija as datas para consultar os insumos.</p>
                    }
                    else
                    {
                        <strong>Nenhum insumo encontrado</strong>
                        <p>Ajuste os filtros ou limpe a busca para ver outros insumos.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Insumo</th>
                                <th scope="col">Categoria</th>
                                <th scope="col">Valor unitário</th>
                                <th scope="col"><span class="visually-hidden">Ações</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                <tr @key="item.Id">
                                    <td class="item-name">@item.Name</td>
                                    <td>@item.CategoryName</td>
                                    <td>@FormatCurrency(item.Value)</td>
                                    <td class="action-cell">
                                        <button class="button-remove"
                                                type="button"
                                                aria-label="@($"Remover {item.Name}")"
                                                @onclick="() => Inventory.Remove(item.Id)">
                                            Remover
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private StockItemForm _form = new();
    private DateTime? _startDate;
    private DateTime? _endDate;
    private Guid? _categoryId;
    private string _search = string.Empty;

    private bool HasFilters =>
        _startDate is not null ||
        _endDate is not null ||
        _categoryId is not null ||
        !string.IsNullOrWhiteSpace(_search);

    private bool HasDateRange => _startDate is not null || _endDate is not null;

    private bool HasInvalidDateRange =>
        _startDate is DateTime startDate &&
        _endDate is DateTime endDate &&
        startDate.Date > endDate.Date;

    private IReadOnlyList<StockItem> FilteredItems
    {
        get
        {
            IEnumerable<StockItem> items = Inventory.Items;
            if (HasInvalidDateRange)
            {
                return [];
            }

            if (HasDateRange)
            {
                var movedItemIds = MovementService.Movements
                    .Where(movement =>
                        (_startDate is null || movement.OccurredAt.Date >= _startDate.Value.Date) &&
                        (_endDate is null || movement.OccurredAt.Date <= _endDate.Value.Date))
                    .SelectMany(movement => movement.Lines)
                    .Select(line => line.ItemId)
                    .ToHashSet();
                items = items.Where(item => movedItemIds.Contains(item.Id));
            }

            if (_categoryId is Guid categoryId)
            {
                items = items.Where(item => item.CategoryId == categoryId);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                items = items.Where(item =>
                    item.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase));
            }

            return items
                .OrderBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToArray();
        }
    }

    private static string FormatCurrency(decimal value) =>
        value.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));

    private void ClearFilters()
    {
        _startDate = null;
        _endDate = null;
        _categoryId = null;
        _search = string.Empty;
    }

    private void AddItem()
    {
        if (_form.CategoryId is not Guid categoryId)
        {
            return;
        }

        Inventory.Add(_form.Name.Trim(), categoryId, _form.Value);
        _form = new StockItemForm();
    }

    private sealed class StockItemForm
    {
        [Required(ErrorMessage = "Informe o nome do insumo.")]
        [StringLength(100, ErrorMessage = "O nome deve ter no máximo 100 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecione uma categoria.")]
        public Guid? CategoryId { get; set; }

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "Informe um valor igual ou maior que zero.")]
        public decimal Value { get; set; }
    }
}
