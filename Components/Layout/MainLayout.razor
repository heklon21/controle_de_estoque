@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/">Mhelbeef <span>Smokehouse</span></a>

        <nav class="sidebar-nav" aria-label="Menu principal">
            <p class="nav-section-label">MENU PRINCIPAL</p>
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
                    <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
                    <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
                    <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
                </svg>
                <span>Dashboard</span>
            </NavLink>
            <button class="nav-group-button"
                    type="button"
                    aria-expanded="@(_isStockMenuExpanded ? "true" : "false")"
                    aria-controls="stock-submenu"
                    @onclick="ToggleStockMenu">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m4 7 8-4 8 4-8 4-8-4Z" />
                    <path d="m4 12 8 4 8-4M4 17l8 4 8-4" />
                </svg>
                <span class="nav-group-label">Controle de estoque</span>
                <svg class="nav-chevron @(_isStockMenuExpanded ? "expanded" : null)"
                     viewBox="0 0 20 20"
                     fill="none"
                     aria-hidden="true">
                    <path d="m6 8 4 4 4-4" />
                </svg>
            </button>
            <div id="stock-submenu"
                 class="nav-submenu"
                 aria-label="Submenus de controle de estoque"
                 hidden="@(!_isStockMenuExpanded)">
                <NavLink class="nav-submenu-link" href="/estoque-total" Match="NavLinkMatch.All">
                    Estoque Total
                </NavLink>
                <NavLink class="nav-submenu-link" href="/movimentacoes" Match="NavLinkMatch.All">
                    Movimentações de estoque
                </NavLink>
                <NavLink class="nav-submenu-link" href="/insumos">
                    Cadastro de insumos
                </NavLink>
                <NavLink class="nav-submenu-link" href="/categorias" Match="NavLinkMatch.All">
                    Categorias
                </NavLink>
                <NavLink class="nav-submenu-link" href="/lista-de-compras" Match="NavLinkMatch.All">
                    Lista de compras
                </NavLink>
            </div>
            <NavLink class="nav-link" href="/fluxo-de-caixa" Match="NavLinkMatch.All">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 10h18M7 15h3" />
                </svg>
                <span>Fluxo de caixa</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <span class="status-indicator" aria-hidden="true"></span>
            Controle de estoque
        </div>
    </aside>

    <div class="main-column">
        <header class="topbar">
            <span class="topbar-label">Painel de controle</span>
        </header>

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _isStockMenuExpanded = true;

    private void ToggleStockMenu() =>
        _isStockMenuExpanded = !_isStockMenuExpanded;
}
